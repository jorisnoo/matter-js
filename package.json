{
  "name": "matter-js",
  "version": "1.0.2",
  "type": "module",
  "private": true,
  "license": "MIT",
  "homepage": "http://brm.io/matter-js/",
  "author": "Liam Brummitt <liam@brm.io> (http://brm.io/)",
  "description": "a 2D rigid body physics engine for the web",
  "exports": {
    ".": {
      "types": "./types/matter-js.d.ts",
      "module": "./src/module/index.js",
      "import": "./build/matter.js",
      "default": "./build/matter.js"
    }
  },
  "module": "build/matter.js",
  "types": "types/matter-js.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jorisnoo/matter-js.git"
  },
  "keywords": [
    "javascript",
    "canvas",
    "html5",
    "physics",
    "physics engine",
    "game engine",
    "rigid body physics"
  ],
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "json-stringify-pretty-compact": "^2.0.0",
    "matter-js-upstream": "npm:matter-js@0.20.0",
    "matter-tools": "^0.14.0",
    "matter-wrap": "^0.2.0",
    "pathseg": "^1.2.0",
    "poly-decomp": "^0.3.0",
    "prettier": "^3.0.0",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "vite --config vite.demo.config.js --open",
    "serve": "vite --config vite.demo.config.js",
    "build": "vite build && vite build --mode min",
    "build-alpha": "vite build --mode alpha && vite build --mode alpha-min",
    "build-dev": "vite build --mode dev && vite build --mode dev-min",
    "build-demo": "vite build --config vite.demo.config.js",
    "lint": "eslint 'src/**/*.js' 'demo/src/**/*.js' 'examples/*.js'",
    "format": "prettier --write 'src/**/*.js' 'demo/src/**/*.js' 'examples/*.js'",
    "benchmark": "MATTER_TEST_EXAMPLES=stress3,stress4 MATTER_TEST_BENCHMARK=true MATTER_TEST_UPDATES=300 MATTER_TEST_REPEATS=3 npm run test-node",
    "test": "npm run test-node",
    "test-node": "npm run build-dev && node --expose-gc node_modules/vitest/vitest.mjs run --exclude test/Browser.spec.js",
    "test-browser": "vitest run test/Browser.spec.js",
    "test-all": "npm run test-node && npm run test-browser",
    "test-save": "MATTER_TEST_SAVE=true npm run test-node",
    "test:watch": "npm run build-dev && vitest --exclude test/Browser.spec.js",
    "test-types": "tsc --noEmit --strict --target es2020 --module esnext --moduleResolution bundler test/types-test.ts"
  },
  "files": [
    "src",
    "build/matter.js",
    "build/matter.min.js",
    "build/matter.js.map",
    "build/matter.min.js.map",
    "types",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ]
}
