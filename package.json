{
  "name": "matter-js",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "homepage": "http://brm.io/matter-js/",
  "author": "Liam Brummitt <liam@brm.io> (http://brm.io/)",
  "description": "a 2D rigid body physics engine for the web",
  "exports": {
    ".": {
      "types": "./types/matter-js.d.ts",
      "module": "./src/module/index.js",
      "import": "./build/matter.js",
      "default": "./build/matter.js"
    }
  },
  "module": "build/matter.js",
  "types": "types/matter-js.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/liabru/matter-js.git"
  },
  "keywords": [
    "javascript",
    "canvas",
    "html5",
    "physics",
    "physics engine",
    "game engine",
    "rigid body physics"
  ],
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "conventional-changelog-cli": "^2.1.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "json-stringify-pretty-compact": "^2.0.0",
    "matter-tools": "^0.14.0",
    "matter-wrap": "^0.2.0",
    "pathseg": "^1.2.0",
    "poly-decomp": "^0.3.0",
    "prettier": "^3.0.0",
    "puppeteer-core": "^5.5.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "vite --config vite.demo.config.js --open",
    "serve": "vite --config vite.demo.config.js",
    "build": "rm -rf build && vite build && MINIFY=true vite build",
    "build-alpha": "KIND=alpha vite build && KIND=alpha MINIFY=true vite build",
    "build-dev": "KIND=dev vite build && KIND=dev MINIFY=true vite build",
    "build-demo": "vite build --config vite.demo.config.js",
    "lint": "eslint 'src/**/*.js' 'demo/src/**/*.js' 'examples/*.js'",
    "format": "prettier --write 'src/**/*.js' 'demo/src/**/*.js' 'examples/*.js'",
    "benchmark": "npm run test-node -- --examples=stress3,stress4 --benchmark=true --updates=300 --repeats=3",
    "test": "npm run test-node",
    "test-node": "npm run build-dev && node --expose-gc node_modules/.bin/vitest run ./test/Examples.spec.js",
    "test-browser": "node --expose-gc node_modules/.bin/vitest run ./test/Browser.spec.js",
    "test-all": "npm run test-node && npm run test-browser",
    "test-save": "npm run test-node -- --save=true",
    "test:watch": "npm run build-dev && node --expose-gc node_modules/.bin/vitest ./test/Examples.spec.js",
    "changelog": "conventional-changelog -i CHANGELOG.md -s -r",
    "prepare": "npm run build",
    "release": "npm version --no-git-tag-version",
    "preversion": "git checkout master && npm run lint && npm run test-node -- --save=true",
    "version": "git checkout -b release/$npm_package_version && npm run build"
  },
  "files": [
    "src",
    "build/matter.js",
    "build/matter.min.js",
    "build/matter.js.map",
    "build/matter.min.js.map",
    "types",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ]
}
